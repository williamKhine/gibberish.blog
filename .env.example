# Next.js development values. Copy to .env.local.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set by npx convex dev:
CONVEX_DEPLOYMENT=

# Set these on the Convex deployment. See README.md for setup.
# SITE_URL=http://localhost:3000
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=
# JWT_PRIVATE_KEY=
# JWKS=
# ADMIN_AUTH_USER_IDS=
# UPLOAD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
